# =============================================================================
# JENGO HARDWARE — ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control — add it to .gitignore.
# =============================================================================


# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_NAME="Jengo Hardware"
APP_ENV=development          # development | production
APP_URL=http://localhost/GitHub/jengo_hardware
APP_DEBUG=true               # Set to false in production


# -----------------------------------------------------------------------------
# DATABASE (MySQL via XAMPP)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jengo_hardware
DB_USER=root
DB_PASS=                     # Leave blank for default XAMPP root (no password)
DB_CHARSET=utf8mb4


# -----------------------------------------------------------------------------
# SAFARICOM DARAJA API — M-PESA
# Sandbox: https://developer.safaricom.co.ke
# -----------------------------------------------------------------------------
MPESA_ENV=sandbox                         # sandbox | production

# OAuth credentials (from your Daraja app)
MPESA_CONSUMER_KEY=your_mpesa_consumer_key_here
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret_here

# Lipa Na M-Pesa Online (STK Push)
MPESA_SHORTCODE=174379                    # Sandbox till: 174379
MPESA_PASSKEY=your_lipa_na_mpesa_online_passkey_here

# Callback URLs — must be publicly accessible HTTPS (use ngrok in dev)
MPESA_CALLBACK_URL=https://your-ngrok-subdomain.ngrok-free.app/payments/mpesa_callback.php

# Daraja API base URLs (do not change unless Safaricom updates endpoints)
MPESA_SANDBOX_URL=https://sandbox.safaricom.co.ke
MPESA_PRODUCTION_URL=https://api.safaricom.co.ke


# -----------------------------------------------------------------------------
# PAYSTACK
# Dashboard: https://dashboard.paystack.com/#/settings/developers
# -----------------------------------------------------------------------------
PAYSTACK_ENV=test                         # test | live

PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here

# Redirect URL after payment (Paystack redirects here with ?reference=xxx)
PAYSTACK_CALLBACK_URL=https://your-ngrok-subdomain.ngrok-free.app/payments/paystack_verify.php

# Webhook URL (Paystack posts events here server-to-server)
PAYSTACK_WEBHOOK_URL=https://your-ngrok-subdomain.ngrok-free.app/payments/paystack_webhook.php

# Paystack base API URL (do not change)
PAYSTACK_BASE_URL=https://api.paystack.co


# -----------------------------------------------------------------------------
# SESSION & SECURITY
# -----------------------------------------------------------------------------
SESSION_LIFETIME=3600        # Session timeout in seconds (3600 = 1 hour)
